    {
      "id": 12,
      "type": "timeseries",
      "title": "Packet rate per node (PPS, 15 dtk)",
      "description": "Pesan PUBLISH per detik. Naik mendadak = indikasi S1/S2/S4.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-mint"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"traffic_metrics\" and r._field == \"pps_15s\")\n  |> filter(fn: (r) => contains(value: r.node, set: ${node:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"node\"])",
