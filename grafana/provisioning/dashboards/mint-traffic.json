      },
      "targets": [
        {
          "refId": "A",
          "query": "import \"experimental\"\n\nnow = from(bucket: \"traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"traffic_metrics\" and r._field == \"bps_15s\")\n  |> filter(fn: (r) => contains(value: r.node, set: ${node:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n  |> set(key: \"node\", value: \"Sekarang\")\n\npast = from(bucket: \"traffic\")\n  |> range(start: experimental.subDuration(d: ${shift}, from: v.timeRangeStart), stop: experimental.subDuration(d: ${shift}, from: v.timeRangeStop))\n  |> filter(fn: (r) => r._measurement == \"traffic_metrics\" and r._field == \"bps_15s\")\n  |> filter(fn: (r) => contains(value: r.node, set: ${node:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n  |> timeShift(duration: ${shift})\n  |> set(key: \"node\", value: \"${shift} lalu\")\n\nunion(tables: [now, past])\n  |> keep(columns: [\"_time\", \"_value\", \"node\"])",
