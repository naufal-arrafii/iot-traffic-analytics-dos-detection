    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "description": "MINT v9.2.6 — metrik 15 dtk, threshold, baseline, dan rasio per node: angka SAMA dengan halaman Grafik PPS di web dashboard sehingga keduanya bisa dibandingkan langsung.",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-mint"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"traffic\", tag: \"node\", start: -24h)"
      },
      {
        "name": "shift",
        "label": "Bandingkan dengan",
        "type": "custom",
        "query": "1m,5m,15m,1h",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "selected": false,
            "text": "1m",
            "value": "1m"
          },
          {
            "selected": true,
            "text": "5m",
            "value": "5m"
          },
          {
            "selected": false,
            "text": "15m",
            "value": "15m"
          },
          {
            "selected": false,
            "text": "1h",
            "value": "1h"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "name": "Annotations & Alerts",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      },
      {
        "name": "ALERT deteksi",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-mint"
        },
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alerts\" and r.kind == \"ALERT\" and r._field == \"value\")\n  |> map(fn: (r) => ({_time: r._time, _value: r.node + \" \" + r.metric + \" ALERT\"}))\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1 · Ringkasan sekarang",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status sistem",
      "description": "SERANGAN bila ada node berstatus ALERT (sama dengan banner di web dashboard).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-mint"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"traffic\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"traffic_metrics\" and r._field == \"alert\")\n  |> filter(fn: (r) => contains(value: r.node, set: ${node:json}))\n  |> last()\n  |> group()\n  |> sum()",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-mint"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0,
                "result": {
                  "text": "NORMAL",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 99,
                "result": {
                  "text": "SERANGAN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
