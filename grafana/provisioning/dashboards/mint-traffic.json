  "title": "MINT - Traffic Monitor (perbandingan)",
  "tags": [
    "mint",
    "v9.2.6"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "2s",
  "time": {
    "from": "now-5m",
    "to": "now"
